# AI assistance (server-only, never exposed to the browser).
# Free local setup: chat runs on a local Ollama model, so no paid key is needed.
# Ollama ignores the key, but the client requires a non-empty value.
AI_API_KEY=ollama
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen2.5:3b

# Voice assistant (server-only). Runs against a free local speech server
# (faster-whisper for speech-to-text, Windows SAPI for text-to-speech), which is
# separate from the chat backend and needs no credential.
AI_SPEECH_BASE_URL=http://127.0.0.1:8000/v1
AI_STT_MODEL=Systran/faster-whisper-tiny
AI_TTS_MODEL=pyttsx3
AI_TTS_VOICE=
