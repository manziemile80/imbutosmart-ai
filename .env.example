# URL of the deployed FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8000

# AI assistance (server-only, never exposed to the browser).
# Any OpenAI-compatible chat completions endpoint works.
# AI_BASE_URL may be set without AI_API_KEY when the endpoint needs no auth.
#
# Groq (free tier): console.groq.com/keys
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-20b
#   AI_API_KEY=gsk_...
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# The chat backend is chosen by name:
#   openai          -> any OpenAI-compatible /chat/completions endpoint
#   vercel-gateway  -> the Vercel AI Gateway, which authenticates a Vercel
#                      deployment with its own OIDC token (no key needed).
#                      Models are addressed as "provider/model", e.g.
#                      openai/gpt-4o-mini.
# AI_PROVIDER=vercel-gateway
# AI_GATEWAY_API_KEY=

# Voice assistant (server-only). It uses the same OpenAI-compatible shape as
# the chat backend, so it can point at the same endpoint.
#
# Groq's speech models are gated: canopylabs/orpheus-v1-english refuses to
# serve until the org admin accepts its terms at the link in the error, and
# playai-tts has been decommissioned. Check the terms before relying on it:
#   AI_SPEECH_BASE_URL=https://api.groq.com/openai/v1
#   AI_STT_MODEL=whisper-large-v3-turbo
#   AI_TTS_MODEL=canopylabs/orpheus-v1-english
#   AI_TTS_VOICE=hannah
#   AI_TTS_FORMAT=wav
#
# The free local speech server (faster-whisper + Windows SAPI) needs no
# credential at all and serves spoken answers:
#   powershell -ExecutionPolicy Bypass -File scripts\start-local-voice.ps1
#   AI_SPEECH_BASE_URL=http://127.0.0.1:8000/v1
#   AI_STT_MODEL=Systran/faster-whisper-tiny
#   AI_TTS_MODEL=pyttsx3
#   AI_TTS_FORMAT=wav
# AI_SPEECH_API_KEY= is optional: a local server that ignores auth still works.
AI_STT_MODEL=whisper-1
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=alloy
AI_TTS_FORMAT=mp3

# Some speech models accept only a limited amount of text per request. The
# answer is split into clips of this many characters and played in order.
# 0 means no limit.
AI_TTS_MAX_CHARS=0

# The languages the speech backend can actually read aloud, comma separated.
# Leave it unset to allow every farmer language. Groq's speech models speak
# English only, so a Groq deployment declares "en" and the other languages are
# offered as writing instead of spoken badly. The free local stack speaks with
# the voices installed on the machine, which is usually English only as well.
# AI_SPEECH_LANGUAGES=en

# Summary email (server-only). The farmer's summary is sent by the app when
# these are set; without them the page opens the farmer's own mail app instead.
# Any endpoint accepting the Resend-style body { from, to, subject, text } works.
# EMAIL_FROM must be a sender your provider has verified, otherwise delivery to
# farmers fails and the page falls back to their mail app.
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=ImbutoSmart <onboarding@resend.dev>

# A mailbox that sends the summary itself over SMTP, used when the HTTP provider
# above is not configured or refuses the address. This reaches any farmer without
# owning a domain. For Gmail, create an App Password (never the account
# password) at https://myaccount.google.com/apppasswords.
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=

# Supabase (only needed if server functions require an authenticated user).
SUPABASE_PROJECT_ID=escrgypngrsqyfkzqbqw
SUPABASE_PUBLISHABLE_KEY=sb_publishable_1yK1fYe0qD3TGv_1QV0FLQ_y4hzKxqW
SUPABASE_URL=https://c--5eebf432-95f5-4468-9f79-f87d749c603c-prod.lovable.cloud
SUPABASE_SERVICE_ROLE_KEY=
