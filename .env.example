# URL of the deployed FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8000

# AI assistance (server-only, never exposed to the browser).
# Any OpenAI-compatible chat completions endpoint works.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Voice assistant (server-only). Same backend, speech-to-text + text-to-speech.
# Requires the endpoint to expose /audio/transcriptions and /audio/speech.
AI_STT_MODEL=whisper-1
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=alloy

# Supabase (only needed if server functions require an authenticated user).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
