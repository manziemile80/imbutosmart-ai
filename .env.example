# URL of the deployed FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8000

# AI assistance (server-only, never exposed to the browser).
# Any OpenAI-compatible chat completions endpoint works.
# AI_BASE_URL may be set without AI_API_KEY when the endpoint needs no auth.
#
# Groq (free tier): console.groq.com/keys
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-20b
#   AI_API_KEY=gsk_...
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# The chat backend is chosen by name:
#   openai          -> any OpenAI-compatible /chat/completions endpoint
#   vercel-gateway  -> the Vercel AI Gateway, which authenticates a Vercel
#                      deployment with its own OIDC token (no key needed).
#                      Models are addressed as "provider/model", e.g.
#                      openai/gpt-4o-mini.
# AI_PROVIDER=vercel-gateway
# AI_GATEWAY_API_KEY=

# Voice assistant (server-only). The speech backend is chosen by name so a
# provider with its own API can be used alongside the OpenAI-compatible one.
#   openai      -> any endpoint exposing /audio/transcriptions and /audio/speech
#   elevenlabs  -> the ElevenLabs native speech endpoints
AI_SPEECH_PROVIDER=openai

# OpenAI-compatible speech (used when AI_SPEECH_PROVIDER=openai).
# AI_SPEECH_API_KEY is optional: a local server that ignores auth still works
# without it.
# AI_SPEECH_BASE_URL=http://127.0.0.1:8000/v1
# AI_SPEECH_API_KEY=
AI_STT_MODEL=whisper-1
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=alloy

# ElevenLabs speech (used when AI_SPEECH_PROVIDER=elevenlabs).
# The API key needs speech permissions only. Free accounts can transcribe, but
# reading answers aloud needs credits or a voice created in the account.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Supabase (only needed if server functions require an authenticated user).
SUPABASE_PROJECT_ID=escrgypngrsqyfkzqbqw
SUPABASE_PUBLISHABLE_KEY=sb_publishable_1yK1fYe0qD3TGv_1QV0FLQ_y4hzKxqW
SUPABASE_URL=https://c--5eebf432-95f5-4468-9f79-f87d749c603c-prod.lovable.cloud
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=escrgypngrsqyfkzqbqw
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_1yK1fYe0qD3TGv_1QV0FLQ_y4hzKxqW
VITE_SUPABASE_URL=https://c--5eebf432-95f5-4468-9f79-f87d749c603c-prod.lovable.cloud
